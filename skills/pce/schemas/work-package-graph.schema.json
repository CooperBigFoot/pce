{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pce.local/schemas/work-package-graph.schema.json",
  "title": "PCE immutable work-package graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vision",
    "plan_version",
    "packages"
  ],
  "properties": {
    "$schema": {
      "$ref": "#/$defs/nonempty"
    },
    "vision": {
      "$ref": "#/$defs/nonempty"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "authored_at_ref": {
      "$ref": "#/$defs/nonempty"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      },
      "minItems": 1
    },
    "authored_at_refs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/nonempty"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonempty"
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "observation",
        "command"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "input": {
          "$ref": "#/$defs/nonempty"
        },
        "observation": {
          "$ref": "#/$defs/nonempty"
        },
        "command": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "kind": {
          "enum": [
            "buildability",
            "safety",
            "risk-ordering"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "repositories",
        "criteria",
        "depends_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "uniqueItems": true
        },
        "external_evidence_root": {
          "$ref": "#/$defs/nonempty",
          "description": "Environment name whose value identifies this package external evidence root."
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "authored_at_ref"
      ]
    },
    {
      "required": [
        "authored_at_refs"
      ]
    }
  ]
}
