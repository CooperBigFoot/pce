{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCE run snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "repositories",
    "steps",
    "dispatches",
    "dispatch_accounting",
    "issuance_ordinals",
    "rounds",
    "non_production_streaks",
    "non_production_holds",
    "holds",
    "provenance",
    "resume",
    "recovery_digest"
  ],
  "properties": {
    "schema_id": {
      "const": "pce.run-snapshot"
    },
    "schema_version": {
      "const": 1
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "dispatches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dispatch"
      }
    },
    "dispatch_accounting": {
      "$ref": "#/$defs/dispatchAccounting"
    },
    "issuance_ordinals": {
      "type": "array",
      "items": { "$ref": "#/$defs/issuanceOrdinalSeries" }
    },
    "rounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roundSeries"
      }
    },
    "non_production_streaks": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonProductionSeries" }
    },
    "non_production_holds": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonProductionHold" }
    },
    "holds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hold"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "resume": {
      "$ref": "#/$defs/resume"
    },
    "recovery_digest": {
      "$ref": "#/$defs/recoveryDigest"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "bytePreservedString": {
      "type": "string"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "base"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "base": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "fetch",
        "branch",
        "worktree",
        "tag"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/bytePreservedString"
        },
        "fetch": {
          "$ref": "#/$defs/repositoryFetch"
        },
        "branch": {
          "$ref": "#/$defs/branch"
        },
        "worktree": {
          "$ref": "#/$defs/worktree"
        },
        "tag": {
          "$ref": "#/$defs/tag"
        }
      }
    },
    "repositoryFetch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "observation_ref",
            "fetched_at"
          ],
          "properties": {
            "state": {
              "const": "observed"
            },
            "observation_ref": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "fetched_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "failure"
          ],
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "failure": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "state": {
          "type": "string",
          "enum": [
            "present",
            "absent"
          ]
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "state"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "state": {
          "type": "string",
          "enum": [
            "present",
            "absent"
          ]
        }
      }
    },
    "tag": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "state"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "state": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "state",
            "target"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "state": {
              "const": "points-to"
            },
            "target": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "subject", "github", "git", "merge_status"],
          "properties": {
            "node": { "$ref": "#/$defs/nonEmptyString" },
            "subject": { "$ref": "#/$defs/mergeSubject" },
            "github": { "$ref": "#/$defs/githubObservation" },
            "git": { "$ref": "#/$defs/gitObservation" },
            "merge_status": {
              "type": "string",
              "enum": ["merged", "not-merged", "inconclusive"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "subject", "exceptional_merge_chain", "merge_status"],
          "properties": {
            "node": { "$ref": "#/$defs/nonEmptyString" },
            "subject": { "$ref": "#/$defs/mergeSubject" },
            "exceptional_merge_chain": { "$ref": "#/$defs/exceptionalMergeChain" },
            "merge_status": {
              "type": "string",
              "enum": ["merged", "not-merged", "inconclusive"]
            }
          }
        }
      ]
    },
    "exceptionalMergeChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_pull_request_number",
        "promotion_pull_request_number",
        "promotion_selector",
        "step_to_integration",
        "integration_to_default"
      ],
      "properties": {
        "step_pull_request_number": { "$ref": "#/$defs/positiveInteger" },
        "promotion_pull_request_number": { "$ref": "#/$defs/positiveInteger" },
        "promotion_selector": { "$ref": "#/$defs/selector" },
        "step_to_integration": { "$ref": "#/$defs/exceptionalMergeHop" },
        "integration_to_default": { "$ref": "#/$defs/exceptionalMergeHop" }
      }
    },
    "exceptionalMergeHop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "git", "merge_status"],
      "properties": {
        "github": { "$ref": "#/$defs/githubObservation" },
        "git": { "$ref": "#/$defs/gitObservation" },
        "merge_status": {
          "type": "string",
          "enum": ["merged", "not-merged", "inconclusive"]
        }
      }
    },
    "mergeSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone",
        "step",
        "head_branch",
        "integration_branch",
        "pull_request_selector"
      ],
      "properties": {
        "milestone": {
          "$ref": "#/$defs/positiveInteger"
        },
        "step": {
          "$ref": "#/$defs/positiveInteger"
        },
        "head_branch": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "integration_branch": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pull_request_selector": {
          "$ref": "#/$defs/selector"
        }
      }
    },
    "githubObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "failure"
          ],
          "properties": {
            "availability": {
              "const": "unreachable"
            },
            "failure": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "cardinality"
          ],
          "properties": {
            "availability": {
              "const": "reachable"
            },
            "cardinality": {
              "const": "zero-exact-matches"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "cardinality"
          ],
          "properties": {
            "availability": {
              "const": "reachable"
            },
            "cardinality": {
              "const": "multiple-exact-matches"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "cardinality",
            "pull_request"
          ],
          "properties": {
            "availability": {
              "const": "reachable"
            },
            "cardinality": {
              "const": "one-exact-match"
            },
            "pull_request": {
              "$ref": "#/$defs/pullRequest"
            }
          }
        }
      ]
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "selector",
        "state"
      ],
      "properties": {
        "number": {
          "$ref": "#/$defs/positiveInteger"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "state": {
          "$ref": "#/$defs/pullRequestState"
        }
      }
    },
    "pullRequestState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "not-merged"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "squash_commit_oid"
          ],
          "properties": {
            "status": {
              "const": "merged"
            },
            "squash_commit_oid": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "gitObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "failure"
          ],
          "properties": {
            "availability": {
              "const": "unreachable"
            },
            "failure": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "state"
          ],
          "properties": {
            "availability": {
              "const": "reachable"
            },
            "state": {
              "const": "not-merged"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "state",
            "squash_commit_oid"
          ],
          "properties": {
            "availability": {
              "const": "reachable"
            },
            "state": {
              "const": "squash-commit-reachable"
            },
            "squash_commit_oid": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "node",
        "role",
        "ref",
        "completion"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/positiveInteger"
        },
        "node": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "$ref": "#/$defs/bytePreservedString"
        },
        "ref": {
          "$ref": "#/$defs/bytePreservedString"
        },
        "completion": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/observedDispatchCompletion" },
            { "$ref": "#/$defs/reconciledDispatchCompletion" }
          ]
        }
      }
    },
    "dispatchAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "issuance_sequences"],
      "properties": {
        "state": { "enum": ["all-accounted", "unaccounted"] },
        "issuance_sequences": { "type": "array", "items": { "$ref": "#/$defs/positiveInteger" } }
      }
    },
    "observedDispatchCompletion": {
      "oneOf": [
        { "$ref": "#/$defs/legacyObservedDispatchCompletion" },
        { "$ref": "#/$defs/currentObservedDispatchCompletion" }
      ]
    },
    "legacyObservedDispatchCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "sequence", "timestamp", "duration_ms", "usage", "exit_status", "artifact_outcome"],
      "properties": {
        "outcome": { "const": "observed-child" },
        "sequence": { "$ref": "#/$defs/positiveInteger" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/dispatchUsage" },
        "exit_status": { "$ref": "#/$defs/dispatchExitStatus" },
        "artifact_outcome": { "enum": ["not-validated", "validated", "missing", "truncated", "schema-invalid", "schema-violating"] }
      }
    },
    "currentObservedDispatchCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "sequence", "timestamp", "duration_ms", "usage", "exit_status", "artifact_outcome", "required_artifact_presence"],
      "properties": {
        "outcome": { "const": "observed-child" },
        "sequence": { "$ref": "#/$defs/positiveInteger" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/dispatchUsage" },
        "exit_status": { "$ref": "#/$defs/dispatchExitStatus" },
        "artifact_outcome": { "enum": ["not-validated", "validated", "missing", "truncated", "schema-invalid", "schema-violating"] },
        "required_artifact_presence": { "enum": ["present", "absent"] }
      }
    },
    "reconciledDispatchCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "sequence", "timestamp", "artifact_production"],
      "properties": {
        "outcome": { "const": "reconciled-dead" },
        "sequence": { "$ref": "#/$defs/positiveInteger" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "artifact_production": { "enum": ["produced", "not-produced"] }
      }
    },
    "dispatchExitStatus": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "code"], "properties": { "kind": { "const": "exited" }, "code": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "signal"], "properties": { "kind": { "const": "signaled" }, "signal": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "dispatchUsage": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["availability", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"], "properties": { "availability": { "const": "measured" }, "input_tokens": { "type": "integer", "minimum": 0 }, "cached_input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 }, "reasoning_output_tokens": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["availability", "input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"], "properties": { "availability": { "const": "claude-measured" }, "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 }, "cache_creation_input_tokens": { "type": "integer", "minimum": 0 }, "cache_read_input_tokens": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["availability", "reason"], "properties": { "availability": { "const": "absent" }, "reason": { "type": "string", "minLength": 1 } } }
      ]
    },
    "roundSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "role",
        "count"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "issuanceOrdinalSeries": {
      "type": "object", "additionalProperties": false,
      "required": ["node", "role", "ordinal"],
      "properties": {
        "node": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/bytePreservedString" },
        "ordinal": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "nonProductionKey": {
      "type": "object", "additionalProperties": false,
      "required": ["node", "role", "required_artifact_path"],
      "properties": {
        "node": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/bytePreservedString" },
        "required_artifact_path": { "type": "string", "pattern": "^/" }
      }
    },
    "nonProductionSeries": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "consecutive"],
      "properties": {
        "key": { "$ref": "#/$defs/nonProductionKey" },
        "consecutive": { "type": "integer", "minimum": 0 }
      }
    },
    "nonProductionHold": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "status"],
      "properties": {
        "key": { "$ref": "#/$defs/nonProductionKey" },
        "status": { "$ref": "#/$defs/nonProductionHoldStatus" }
      }
    },
    "nonProductionHoldStatus": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state", "sequence"], "properties": { "state": { "const": "open" }, "sequence": { "$ref": "#/$defs/positiveInteger" } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "sequence", "resolution"], "properties": { "state": { "const": "closed" }, "sequence": { "$ref": "#/$defs/positiveInteger" }, "resolution": { "enum": ["retry", "re-plan", "abandon"] } } }
      ]
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "status"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/bytePreservedString"
        },
        "status": {
          "$ref": "#/$defs/holdStatus"
        }
      }
    },
    "holdStatus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "node",
            "sequence",
            "question"
          ],
          "properties": {
            "state": {
              "const": "open"
            },
            "node": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/positiveInteger"
            },
            "question": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "node",
            "sequence",
            "resolution"
          ],
          "properties": {
            "state": {
              "const": "closed"
            },
            "node": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/positiveInteger"
            },
            "resolution": {
              "type": "string"
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "approved_sha256",
        "approval_node",
        "approval_sequence",
        "condition"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/bytePreservedString"
        },
        "approved_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approval_node": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "approval_sequence": {
          "$ref": "#/$defs/positiveInteger"
        },
        "condition": {
          "$ref": "#/$defs/provenanceCondition"
        }
      }
    },
    "provenanceCondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "digest-matches"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "approved_sha256",
            "current_sha256"
          ],
          "properties": {
            "state": {
              "const": "digest-mismatch"
            },
            "approved_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "current_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "artifact-missing"
            }
          }
        }
      ]
    },
    "resume": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "no-log-visible-candidate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "node",
            "latest_sequence",
            "cycle_position"
          ],
          "properties": {
            "state": {
              "const": "candidate"
            },
            "node": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "latest_sequence": {
              "$ref": "#/$defs/positiveInteger"
            },
            "cycle_position": {
              "$ref": "#/$defs/cyclePosition"
            }
          }
        }
      ]
    },
    "cyclePosition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "no-round-dispatch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "sequence"
          ],
          "properties": {
            "state": {
              "const": "plan-dispatched"
            },
            "sequence": {
              "$ref": "#/$defs/positiveInteger"
            }
          }
        },
        {
