+/// Validated-production defect-round cap per `(node, role)`.
+///
+/// Defaults to 3. `PCE_DEFECT_ROUND_CAP` raises it for a single orchestration whose
+/// decomposition legitimately changed premise mid-run, so that authoring and review
+/// capacity can be restored without rewriting an append-only event log. A value that
+/// is absent, unparseable, or below the default leaves the default in force, so the
+/// override can only loosen the cap deliberately and never tighten or disable it.
+fn defect_round_cap() -> u64 {
+    std::env::var("PCE_DEFECT_ROUND_CAP")
+        .ok()
+        .and_then(|raw| raw.trim().parse::<u64>().ok())
+        .filter(|cap| *cap > 3)
+        .unwrap_or(3)
+}
